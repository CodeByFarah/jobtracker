# Copy this file to `.env` (which is git-ignored) and replace the placeholder values.
# The backend reads it automatically (spring.config.import) and docker compose uses it
# to initialise the PostgreSQL container.

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/jobtrack
DATABASE_USERNAME=jobtrack
DATABASE_PASSWORD=change-me-to-a-strong-password

# --- Authentication -----------------------------------------------------------
# HMAC key used to sign JWTs. Must be at least 32 bytes (256 bits).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Access-token lifetime in minutes (default: 1440 = 24h)
JWT_EXPIRATION_MINUTES=1440

# --- HTTP ---------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Backend port (default 8080) and the host port docker compose maps PostgreSQL to (default 5432).
# Change them if another project already uses those ports; keep DATABASE_URL's port in sync with
# DB_PORT, and point the frontend at the backend with VITE_API_PROXY_TARGET in frontend/.env.local.
# SERVER_PORT=8081
# DB_PORT=5433

# --- Local AI (Ollama) --------------------------------------------------------
# Free and local: install Ollama, then `ollama pull qwen3:4b-instruct-2507-q4_K_M`.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- Gmail tracking (optional) ------------------------------------------------
# OAuth client from Google Cloud (type "Web application"). See README > Gmail tracking.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud. The default goes through the Vite proxy.
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmail/oauth/callback
# GMAIL_SYNC_INTERVAL=PT30M
